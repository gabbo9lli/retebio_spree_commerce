# Retebio Environment Configuration Template

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Rails Production Secret
SECRET_KEY_BASE=change_me_to_a_long_random_secret_hex_token

# Store Domains (used by Caddy reverse proxy on AWS/Production)
STORE_DOMAIN=store.retebio.it
API_DOMAIN=api.retebio.it

# AWS S3 Storage for Catalog Media (Low-cost S3 bucket)
ACTIVE_STORAGE_SERVICE=amazon
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-central-1
AWS_S3_BUCKET=retebio-media-prod
AWS_BUCKET=retebio-media-prod
SPREE_STORE_URL=api.retebio.it
